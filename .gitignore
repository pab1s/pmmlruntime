# Rust
/target/
**/target/
**/*.rs.bk
/debug/
# The root lockfile is committed: the Dockerfile copies it and `cargo publish
# --locked` needs it. The binding crates resolve their own lockfiles.
/java/native/Cargo.lock
/python/_native/Cargo.lock
/javascript/node/Cargo.lock
/javascript/web/Cargo.lock
/fuzz/Cargo.lock

