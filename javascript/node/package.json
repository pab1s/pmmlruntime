{
  "name": "pmmlruntime-node",
  "version": "0.1.1",
  "description": "PMML 4.4 without the JVM — Node binding over C PmmlApi (like onnxruntime-node)",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "engines": {
    "node": ">=18"
  },
  "napi": {
    "binaryName": "pmmlruntime-node",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ]
  },
  "optionalDependencies": {
    "pmmlruntime-node-linux-x64-gnu": "0.1.1",
    "pmmlruntime-node-linux-arm64-gnu": "0.1.1",
    "pmmlruntime-node-darwin-x64": "0.1.1",
    "pmmlruntime-node-darwin-arm64": "0.1.1",
    "pmmlruntime-node-win32-x64-msvc": "0.1.1"
  },
  "scripts": {
    "build": "napi build --platform --release",
    "test": "node test.js"
  }
}
